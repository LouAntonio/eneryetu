generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
}

// --- ENUMS ---

enum Role {
	ADMIN
	EDITOR
}

enum Status {
	RASCUNHO
	PUBLICADO
	ARQUIVADO
}

enum PostType {
	NOTICIA
	BLOG
}

// --- UTILIZADORES E AUTENTICAÇÃO ---

model User {
	id        String   @id @default(uuid()) @db.VarChar(36)
	name      String   @db.VarChar(32)
	surname   String   @db.VarChar(32)
	email     String   @unique @db.VarChar(64)
	password  String   @db.VarChar(255)
	role      Role     @default(ADMIN)
	lastLogin DateTime @default(now())
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	// Relacionamentos
	events        Event[]
	posts         Post[]
	refreshTokens RefreshToken[]
}

model RefreshToken {
	id        String   @id @default(uuid()) @db.VarChar(36)
	token     String   @unique @db.VarChar(512)
	userId    String   @db.VarChar(36)
	user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
	expiresAt DateTime
	createdAt DateTime @default(now())
}

// --- TAXONOMIA (Substitui os Enums fixos) ---

model EventType {
	id     String  @id @default(uuid()) @db.VarChar(36)
	name   String  @unique @db.VarChar(64) // Ex: "Cimeira de Negócios"
	slug   String  @unique @db.VarChar(80)
	events Event[]
}

model Category {
	id    String @id @default(uuid()) @db.VarChar(36)
	name  String @db.VarChar(64)
	slug  String @unique @db.VarChar(80)
	posts Post[]
}

// --- CONTEÚDO: EVENTOS ---

model Event {
	id       String  @id @default(uuid()) @db.VarChar(36)
	title    String  @db.VarChar(128)
	subtitle String? @db.VarChar(256)
	slug     String  @unique @db.VarChar(160)

	description     String  @db.VarChar(255) // Resumo curto
	fullDescription String? @db.Text // Conteúdo rico/HTML

	startDate   DateTime  @db.Date
	endDate     DateTime? @db.Date
	displayDate String    @db.VarChar(64) // Ex: "Outubro 2024"

	status   Status  @default(RASCUNHO)
	featured Boolean @default(false)

	// Localização
	countryName String  @db.VarChar(64)
	city        String? @db.VarChar(128)
	venue       String? @db.VarChar(256)

	// Mídia
	coverImage          String? @db.VarChar(512)
	coverImagePublicId  String? @db.VarChar(255) // public_id na Cloudinary
	gallery    Json? // Lista de URLs de imagens
	documents  Json? // PDFs, Brochuras

	// SEO
	metaTitle       String? @db.VarChar(70)
	metaDescription String? @db.VarChar(160)

	// Relacionamentos
	eventTypeId String    @db.VarChar(36)
	eventType   EventType @relation(fields: [eventTypeId], references: [id])

	createdBy String? @db.VarChar(36)
	creator   User?   @relation(fields: [createdBy], references: [id])

	createdAt   DateTime  @default(now())
	updatedAt   DateTime  @updatedAt
	publishedAt DateTime?
}

// --- CONTEÚDO: NOTÍCIAS E BLOG ---

model Post {
	id      String   @id @default(uuid()) @db.VarChar(36)
	type    PostType @default(NOTICIA)
	title   String   @db.VarChar(150)
	slug    String   @unique @db.VarChar(180)
	excerpt String?  @db.VarChar(255)
	content String   @db.Text

	coverImage          String? @db.VarChar(512)
	coverImagePublicId  String? @db.VarChar(255) // public_id na Cloudinary
	status     Status  @default(RASCUNHO)
	featured   Boolean @default(false)

	// SEO
	metaTitle       String? @db.VarChar(70)
	metaDescription String? @db.VarChar(160)

	// Relacionamentos
	authorId String @db.VarChar(36)
	author   User   @relation(fields: [authorId], references: [id])

	categoryId String?   @db.VarChar(36)
	category   Category? @relation(fields: [categoryId], references: [id])

	createdAt   DateTime  @default(now())
	updatedAt   DateTime  @updatedAt
	publishedAt DateTime?
}

// --- CONTEÚDO: GALERIA ---

model GalleryCategory {
	id        String         @id @default(uuid()) @db.VarChar(36)
	name      String         @unique @db.VarChar(64)
	slug      String         @unique @db.VarChar(80)
	sortOrder Int            @default(0)
	photos    GalleryPhoto[]
	createdAt DateTime       @default(now())
	updatedAt DateTime       @updatedAt
}

model GalleryPhoto {
	id         String          @id @default(uuid()) @db.VarChar(36)
	title      String?         @db.VarChar(255)
	imageUrl   String          @db.VarChar(500)
	publicId   String?         @db.VarChar(255)
	categoryId String          @db.VarChar(36)
	category   GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
	sortOrder  Int             @default(0)
	createdAt  DateTime        @default(now())
	updatedAt  DateTime        @updatedAt

	@@index([categoryId])
}

// --- CONTEÚDO: TREINAMENTOS ---

model Training {
	id               String   @id @default(uuid()) @db.VarChar(36)
	title            String   @db.VarChar(255)
	slug             String   @unique @db.VarChar(120)
	description      String?  @db.Text
	coverImage       String?  @db.VarChar(500)
	coverImagePubId  String?  @db.VarChar(255)
	durationDays     Int?
	dayPattern       String?  @db.VarChar(100)
	dailyStartTime   String?  @db.VarChar(20)
	dailyEndTime     String?  @db.VarChar(20)
	deliveryMode     String   @default("presencial") @db.VarChar(32)
	price            Decimal? @db.Decimal(10,2)
	currency         String   @default("USD") @db.VarChar(10)
	includesCert     Boolean  @default(false)
	includesExam     Boolean  @default(false)
	learningOutcomes String?  @db.Text
	modules          String?  @db.Text
	prerequisites    String?  @db.VarChar(255)
	pduCredits       Decimal? @db.Decimal(5,1)
	ceuCredits       Decimal? @db.Decimal(5,1)
	pmiProgramNumber String?  @db.VarChar(20)
	status           Status   @default(RASCUNHO)
	featured         Boolean  @default(false)
	sortOrder        Int      @default(0)
	metaTitle        String?  @db.VarChar(160)
	metaDescription  String?  @db.VarChar(320)
	createdBy        String?  @db.VarChar(36)
	createdAt        DateTime @default(now())
	updatedAt        DateTime @updatedAt
	publishedAt      DateTime?

	@@index([slug])
	@@index([status])
}

// --- CONTEÚDO: VAGAS ---

model JobListing {
	id             String   @id @default(uuid()) @db.VarChar(36)
	title          String   @db.VarChar(255)
	slug           String   @unique @db.VarChar(120)
	description    String   @db.Text
	department     String?  @db.VarChar(100)
	location       String?  @db.VarChar(100)
	jobType        String   @default("fulltime") @db.VarChar(32)
	status         Status   @default(RASCUNHO)
	featured       Boolean  @default(false)
	metaTitle      String?  @db.VarChar(160)
	metaDescription String? @db.VarChar(320)
	createdBy      String?  @db.VarChar(36)
	createdAt      DateTime @default(now())
	updatedAt      DateTime @updatedAt
	publishedAt    DateTime?

	@@index([slug])
	@@index([status])
}
